    "html": "<link rel='preconnect' href='https://fonts.googleapis.com'><link href='https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@500;600;700&display=swap' rel='stylesheet'><style>#main-content{--ink:#14212b;--line:#e4dccb;--warm:#f6f1e7;--muted:#4b5560;--y:#e0b050;--gd:#1d5c4a;--deep:#14392f;--d:'Archivo Narrow','Arial Narrow',sans-serif;--ease:cubic-bezier(.16,1,.3,1)} #main-content ::selection{background:#e0b050;color:#14212b} .ex-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:.8rem 1.6rem;font-family:var(--d);font-weight:700;font-size:1.05rem;border-radius:2px;text-decoration:none;border:1px solid transparent;transition:background-color .2s var(--ease),border-color .2s var(--ease)} .ex-btn:focus-visible{outline:3px solid var(--ink);outline-offset:3px} .ex-end .ex-btn:focus-visible{outline-color:var(--y)} .ex-btn-y{background:var(--y);color:var(--ink)} .ex-btn-y:hover{background:#ecc374} .ex-btn-o{border-color:#8b9a90;color:var(--ink)} .ex-btn-o:hover{border-color:var(--ink)} .ex-btn-k{background:var(--ink);color:#fff} .ex-btn-k:hover{background:#27384a} .ex-band .ex-btn:focus-visible{outline-color:var(--ink)} .ex-hero{background:#eaf1ec;color:var(--ink);box-sizing:border-box;display:flex;align-items:center;min-height:calc(100vh - 80px);min-height:calc(100svh - 80px);padding:clamp(1.5rem,4vh,4rem) 1.5rem} .ex-hero-in{width:100%;max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1.2fr 1fr;gap:clamp(2rem,5vw,4.5rem);align-items:center} .ex-hero h1{font-family:var(--d);font-weight:700;font-size:clamp(2.4rem,5.2vw,4.2rem);line-height:1.02;letter-spacing:-.01em;color:var(--ink);margin:0 0 1.5rem;max-width:14ch;text-wrap:balance} .ex-hero p{font-size:1.1rem;line-height:1.6;color:#3d4a55;max-width:48ch;margin:0 0 2rem} .ex-actions{display:flex;gap:1rem;flex-wrap:wrap} .ex-fig{margin:0;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.8fr);gap:1.5rem;align-items:stretch} .ex-fig svg{width:100%;height:auto;max-height:min(460px,calc(100svh - 11rem));display:block;align-self:center} .ex-stats{display:flex;flex-direction:column;justify-content:space-between;padding:0 0 1.5rem;margin:0;list-style:none} .ex-stats li{border-top:1px solid #b9cabf;padding-top:.75rem;margin:0} .ex-num{display:block;font-family:var(--d);font-weight:700;font-size:clamp(1.8rem,3vw,2.5rem);line-height:1;color:var(--gd);font-variant-numeric:tabular-nums} .ex-lab{display:block;font-size:.92rem;line-height:1.4;color:var(--muted);margin-top:.35rem} .ex-sec{padding:clamp(3.5rem,8vw,6.5rem) 1.5rem;background:#fff} .ex-sec-warm{background:var(--warm)} .ex-wrap{max-width:1180px;margin:0 auto} .ex-h2{font-family:var(--d);font-weight:700;font-size:clamp(2rem,3.4vw,3rem);line-height:1.08;color:var(--ink);margin:0;text-wrap:balance} .ex-2col{display:grid;grid-template-columns:1fr 1.3fr;gap:clamp(2rem,5vw,4.5rem);align-items:start} .ex-lead{font-size:1.1rem;line-height:1.65;color:var(--muted);max-width:38ch;margin:1.25rem 0 0} .ex-pts{list-style:none;margin:0;padding:0} .ex-pts li{padding:1.25rem 0;border-top:1px solid #d6d3c9;margin:0} .ex-pts li:last-child{border-bottom:1px solid #d6d3c9} .ex-pts b{display:block;font-family:var(--d);font-size:1.35rem;line-height:1.2;color:var(--ink);margin-bottom:.3rem} .ex-pts span{font-size:1rem;line-height:1.6;color:var(--muted)} .ex-grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:2.5rem;margin-top:3rem} .ex-grid3>div{border-top:2px solid var(--ink);padding-top:1rem} .ex-grid3 h3{font-family:var(--d);font-size:1.35rem;font-weight:700;color:var(--ink);margin:0 0 .4rem;line-height:1.2} .ex-grid3 p{margin:0;font-size:1rem;line-height:1.6;color:var(--muted)} .ex-svc-head{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;flex-wrap:wrap;padding-bottom:1.75rem;border-bottom:2px solid var(--ink)} .ex-svc-head p{margin:0;color:var(--muted);max-width:34ch;font-size:1.02rem;line-height:1.5} .ex-svcs{display:grid;grid-template-columns:repeat(2,1fr);column-gap:3rem} .ex-svc{display:grid;grid-template-columns:1fr auto;gap:.25rem 1rem;align-items:center;padding:1.3rem .25rem;border-bottom:1px solid var(--line);text-decoration:none;color:inherit;transition:background-color .2s var(--ease),padding .2s var(--ease)} .ex-svc:hover{background:var(--warm);padding-left:.9rem} .ex-svc:focus-visible{outline:3px solid var(--ink);outline-offset:-3px} .ex-svc-t{font-family:var(--d);font-weight:700;font-size:1.25rem;line-height:1.2;color:var(--ink)} .ex-svc-d{grid-column:1;font-size:.95rem;line-height:1.5;color:var(--muted)} .ex-svc svg{grid-column:2;grid-row:1/span 2;width:20px;height:20px;stroke:var(--ink);fill:none;stroke-width:2;transition:transform .2s var(--ease)} .ex-svc:hover svg{transform:translateX(4px)} .ex-band{background:var(--y);padding:clamp(3rem,6vw,4.5rem) 1.5rem} .ex-end{background:var(--deep);padding:clamp(3rem,6vw,4.5rem) 1.5rem} .ex-band-in{max-width:1180px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;gap:2rem;flex-wrap:wrap} .ex-band p{margin:.6rem 0 0;color:#2c3136;font-size:1.1rem;line-height:1.5} .ex-end .ex-h2{color:#fff} .ex-end p{margin:.6rem 0 0;color:#cfe3d8;font-size:1.1rem;line-height:1.5} @media (max-width:820px){.ex-hero-in,.ex-2col{grid-template-columns:1fr}.ex-fig{max-width:440px}.ex-grid3{grid-template-columns:1fr 1fr}.ex-svcs{grid-template-columns:1fr}} @media (max-width:560px){.ex-grid3{grid-template-columns:1fr}.ex-sec,.ex-hero,.ex-band,.ex-end{padding-left:1.25rem;padding-right:1.25rem}}</style><header class='ex-hero' aria-label='Hero'><div class='ex-hero-in'><div><h1>La tua casa a Mentana, dalla ricerca al rogito.</h1><p>Agenzia immobiliare a Mentana e nei comuni vicini: valutazione gratuita, vendita, acquisto e affitto, con un unico referente che ti segue dalla prima visita alla firma dal notaio.</p><div class='ex-actions'><a class='ex-btn ex-btn-y' href='__BASEURL__/contatti/'>Valuta la tua casa</a><a class='ex-btn ex-btn-o' href='__BASEURL__/progetti/'>Vedi gli immobili</a></div></div><figure class='ex-fig'><svg viewBox='0 0 300 360' role='img' aria-label='Illustrazione di una casa con tetto a falde e giardino'><line x1='0' y1='320' x2='300' y2='320' stroke='#9db3a6' stroke-width='2'/><rect x='50' y='150' width='200' height='170' fill='#fff' stroke='#9db3a6' stroke-width='2'/><path d='M34 154L150 60L266 154Z' fill='#1d5c4a' stroke='#14392f' stroke-width='2' stroke-linejoin='round'/><rect x='198' y='84' width='22' height='40' fill='#14392f'/><rect x='134' y='230' width='32' height='90' fill='#e0b050' stroke='#b88a2a' stroke-width='2'/><rect x='72' y='184' width='44' height='44' fill='#eaf1ec' stroke='#9db3a6' stroke-width='2'/><rect x='184' y='184' width='44' height='44' fill='#eaf1ec' stroke='#9db3a6' stroke-width='2'/><line x1='94' y1='184' x2='94' y2='228' stroke='#9db3a6'/><line x1='206' y1='184' x2='206' y2='228' stroke='#9db3a6'/><circle cx='36' cy='292' r='24' fill='#b9cabf'/><rect x='34' y='300' width='4' height='20' fill='#7d8f84'/><circle cx='268' cy='296' r='20' fill='#b9cabf'/><rect x='266' y='302' width='4' height='18' fill='#7d8f84'/></svg><ul class='ex-stats'><li><b class='ex-num'>Gratis</b><span class='ex-lab'>la valutazione della tua casa, senza impegno</span></li><li><b class='ex-num'>24 h</b><span class='ex-lab'>per rispondere alla tua richiesta (festivi esclusi)</span></li><li><b class='ex-num'>4 comuni</b><span class='ex-lab'>Mentana, Monterotondo, Fonte Nuova, Sant'Angelo Romano</span></li></ul></figure></div></header>"
